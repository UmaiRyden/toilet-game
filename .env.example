PORT=8080
VITE_DEV_SERVER_PORT=3000
VITE_BACKEND_ORIGIN=http://127.0.0.1:8080
VITE_APP_ORIGIN=http://localhost:3000
VITE_WS_URL=ws://127.0.0.1:8080/ws

# Redis (live room/match state). Defaults to redis://localhost:6379 if unset.
# Start locally: docker run -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379
# Key namespace — change per-environment if sharing one Redis instance.
REDIS_KEY_PREFIX=toilet

# Postgres (durable match history + leaderboard). Defaults to postgresql://localhost:5432/toilet_game.
# Start locally:
#   docker run --name toilet-postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=toilet_game -p 5432:5432 -d postgres:16-alpine
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toilet_game
# Set to true for hosted providers that require TLS (Railway, Supabase, Neon).
DATABASE_SSL=false